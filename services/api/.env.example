APP_PORT=18080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=creatorhub
MYSQL_USER=creatorhub
MYSQL_PASSWORD=change_me
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME_MINUTES=5
AUTH_TOKEN_SECRET=replace_with_at_least_32_random_characters
AUTH_TOKEN_TTL_HOURS=168
SCRAPER_INTERVAL=4h
SCRAPER_TIMEOUT=15m
SCRAPER_PYTHON_BIN=scraper/.venv/bin/python
SCRAPER_SCRIPT_PATH=scraper/free_video_scraper.py
# Bright Data Web Scraper API (TikTok dataset ID from Scraper Library)
BRIGHTDATA_API_KEY=
BRIGHTDATA_TIKTOK_DATASET_ID=
TIKTOK_TRENDING_URL=https://www.tiktok.com/explore
TIKTOK_IMPORT_LIMIT=20
# Yaohu short-drama catalog importer (required only when running cmd/importshortdramas)
YAOHUD_API_KEY=
YAOHUD_QUERY=短剧
YAOHUD_SOURCE=1
YAOHUD_IMPORT_LIMIT=20
# Alibaba TOP Shuqi drama importer (requires an AppKey and AppSecret)
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_QUERY=短剧
ALIBABA_PAGE_SIZE=20
ALIBABA_IMPORT_LIMIT=20
# AA1 free short-drama API importer (no credential; endpoint documented at api.aa1.cn)
AA1_QUERY=
AA1_PAGE_SIZE=20
AA1_IMPORT_LIMIT=20
# ISTERO short-drama search importer (keep credentials local; do not commit them)
ISTERO_AUTHORIZATION=
ISTERO_TOKEN=
ISTERO_QUERY=短剧
ISTERO_IMPORT_LIMIT=20
# Quark public share short-drama importer (public metadata only; no credentials)
QUARK_SHARE_URL=
QUARK_API_HOST=https://drive-m.quark.cn
QUARK_IMPORT_LIMIT=1000
